# Backend config uses upstream DT_* variables; scripts/dev.sh maps DATA_DIR.
DATA_DIR=/path/outside/checkout/homequest-data
DT_SERVER_PORT=2021
TELEGRAM_BOT_TOKEN=
TELEGRAM_TRANSPORT=polling
NICKLLM_BASE_URL=https://vyceai.com/v1
NICKLLM_API_KEY=
# Verified via authenticated VyceAI /models; retain legacy config names.
NICKLLM_MODEL=deepseek-4.1-flash-1017
STT_PROVIDER=local_faster_whisper
STT_MODEL=small
BILLING_MODE=manual_test
LOG_LEVEL=info
# LLM stays unavailable until NICKLLM_MODEL is verified against the provider.
REMINDER_OFFSETS_MINUTES=-60,0,120
HOMEQUEST_HEALTH_ADDR=127.0.0.1:2022
# Optional JSON credentials file outside Git:
HOMEQUEST_SECRETS_FILE=
STT_PYTHON=/path/to/stt-venv/bin/python
STT_MODEL_DIR=/path/outside/checkout/stt-models
AI_DAILY_LIMIT=100
AI_PREMIUM_DAILY_LIMIT=500
