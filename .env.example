# Backend config uses upstream DT_* variables; scripts/dev.sh maps DATA_DIR.
DATA_DIR=/path/outside/checkout/homequest-data
DT_SERVER_PORT=2021
TELEGRAM_BOT_TOKEN=
TELEGRAM_TRANSPORT=polling
NICKLLM_BASE_URL=https://api-ai.nickproject.org/v1
NICKLLM_API_KEY=
# Unconfirmed: do not guess or substitute a model.
NICKLLM_MODEL=
STT_PROVIDER=local_faster_whisper
STT_MODEL=small
BILLING_MODE=manual_test
LOG_LEVEL=info
# Telegram/AI/STT/billing settings are reserved; product adapters not yet wired.
