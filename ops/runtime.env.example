DATA_DIR=/var/lib/homequest
HOMEQUEST_SECRETS_FILE=/etc/homequest/secrets.json
HOMEQUEST_HEALTH_ADDR=127.0.0.1:2022
TELEGRAM_TRANSPORT=polling
TELEGRAM_UI=buttons
BILLING_MODE=manual_test
LOG_LEVEL=info
STT_PYTHON=/opt/homequest/stt-venv/bin/python
STT_MODEL_DIR=/opt/homequest/stt-models
STT_MODEL=small
PYTHONDONTWRITEBYTECODE=1
HF_HUB_OFFLINE=1

# Enable after agent migration/checks; legacy restores the original parser.
AI_MODE=agent
